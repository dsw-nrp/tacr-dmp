                "privacyReason": {},
                "isIntellectualPropertyReason": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isIntellectualPropertyReason|default(None),
                "intellectualPropertyReason": {},
                "isAuthenticatedAccess": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isAuthenticatedAccess|default(None),
