        {%- if reuseRestrictionItem.isPlanned.isForAllDatasets._value is sameas true -%}
            {# Assign to all datasets #}
            {%- for dataset in result.dmp.datasets -%}
                {%- if dataset.get("reuseRestriction") is none -%}
                    {%- do dataset.update({"reuseRestriction": reuseRestriction.uuid}) -%}
                    {%- do usedBy.append(dataset.uuid) -%}
                {%- endif -%}
            {%- endfor -%}

        {%- elif reuseRestrictionItem.isPlanned.isForAllDatasets._value is sameas false -%}
            {# Assign to related datasets #}
            {%- for relatedDataset in reuseRestrictionItem.isPlanned.isForAllDatasets.relatedDatasets -%}
                {%- if relatedDataset.relatedDataset and relatedDataset.relatedDataset._uuid in datasetsMap -%}
                    {%- set ds = datasetsMap[relatedDataset.relatedDataset._uuid] -%}
                    {%- if ds.get("reuseRestriction") is none -%}
                        {%- do ds.update({"reuseRestriction": reuseRestriction.uuid}) -%}
                        {%- do usedBy.append(ds.uuid) -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endif -%}

        {# assign usedBy to reuseRestriction #}
        {%- do reuseRestriction.update({"usedBy": usedBy}) -%}
        {%- do result.dmp.sharedResources.reuseRestrictions.append(reuseRestriction) -%}
        
    {%- elif reuseRestrictionItem.isPlanned._value is sameas true -%}
        {%- do reuseRestriction.update({"usedBy": usedBy}) -%}
        {%- do result.dmp.sharedResources.reuseRestrictions.append(reuseRestriction) -%}
    {%- endif -%}
{%- endfor -%}

{# Mapping [Required tools] #}
{%- do result.dmp.update({'areSpecialToolsRequired': data.obj.areToolsForAccessReuse|default(None)}) -%}
{%- if result.dmp.areSpecialToolsRequired -%}
    {%- if result.dmp.areSpecialToolsRequired._value is sameas true -%}
        {%- for toolItem in data.obj.areToolsForAccessReuse.toolsForAccessReuse -%}
            {%- set tool = {
                "uuid": toolItem._uuid,
                "name": toolItem.name|default(None),
                "description": toolItem.description|default(None),
                "isFreeAndAvailable": toolItem.isFreeAndAvailable|default(None),
                "noAvailableSolution": None,
                "hasAccessLink": toolItem.hasAccessLink|default(None),
                "identifier": {},
                "noAccessLinkAlternatives": {},
                "isAvailableInInstitution": toolItem.isAvailableInInstitution|default(None),
                "usedBy": [],
            } -%}
            {%- if tool.isFreeAndAvailable._value is sameas false -%}
                {%- do tool.update({
                    "noAvailableSolution": toolItem.isFreeAndAvailable.noAvailableSolution|default(None),
                }) -%}
            {%- endif -%}
            {%- if tool.hasAccessLink._value is sameas true -%}
                {%- do tool.update({
                    "identifier": {
                        "value": toolItem.hasAccessLink.value|default(None),
                        "type": toolItem.hasAccessLink.type|default(None),
                    },
                }) -%}
            {%- elif tool.hasAccessLink._value is sameas false -%}
                {%- do tool.noAccessLinkAlternatives.update({
                    "includesDocumentation": toolItem.hasAccessLink.includesDocumentation|default(None),
                    "noDocumentationReason": None,
                    "includesSoftware": toolItem.hasAccessLink.includesSoftware|default(None),
                }) -%}
                {%- if tool.noAccessLinkAlternatives.includesDocumentation._value is sameas false -%}
                    {%- do tool.noAccessLinkAlternatives.update({
                        "noDocumentationReason": toolItem.hasAccessLink.includesDocumentation.noDocumentationReason|default(None),
                    }) -%}
                {%- endif -%}
            {%- endif -%}

            {# Determine which datasets use this tool #}
            {%- set usedBy = [] -%}

            {%- if toolItem.isForAllDatasets._value is sameas true -%}
                {# Assign this tool to all datasets #}
                {%- for datasetUuid, dataset in datasetsMap.items() -%}
                    {# Append this tool if not already there #}
                    {%- if toolItem._uuid not in dataset.tools -%}
                        {%- do datasetsMap[datasetUuid].tools.append(tool.uuid) -%}
                        {%- do tool.usedBy.append(datasetUuid) -%}
                    {%- endif -%}
                {%- endfor -%}
                {%- for reusedDataset in result.dmp.reusingData.consideredDatasets -%}
                    {%- if reusedDataset.isReused is defined and reusedDataset.isReused._value is sameas true -%}
                        {# Append this tool if not already there #}
                        {%- if toolItem._uuid not in reusedDataset.reusedData.tools -%}
                            {%- do reusedDatasetsMap[reusedDataset.uuid].reusedData.tools.append(tool.uuid) -%}
                            {%- do tool.usedBy.append(reusedDataset.uuid) -%}
                        {%- endif -%}
                    {%- endif -%}
                {%- endfor -%}
                {%- do result.dmp.sharedResources.tools.append(tool) -%}

            {%- elif toolItem.isForAllDatasets._value is sameas false -%}
                {# Assign this tool only to specified datasets #}
                {%- for relatedDatasetItem in toolItem.isForAllDatasets.relatedDatasets -%}
                    {%- if relatedDatasetItem.typeOfDataset._value == "relatedProducedDatasets" -%}
                        {%- if relatedDatasetItem.typeOfDataset.relatedProducedDataset and relatedDatasetItem.typeOfDataset.relatedProducedDataset._uuid in datasetsMap -%}
                            {%- do datasetsMap[relatedDatasetItem.typeOfDataset.relatedProducedDataset._uuid].tools.append(tool.uuid) -%}
                            {%- do tool.usedBy.append(relatedDatasetItem.typeOfDataset.relatedProducedDataset._uuid) -%}
                        {%- endif -%}
                    {%- elif relatedDatasetItem.typeOfDataset._value == "relatedReusedDatasets" -%}
                        {%- if relatedDatasetItem.typeOfDataset.relatedReusedDataset and relatedDatasetItem.typeOfDataset.relatedReusedDataset._uuid in reusedDatasetsMap -%}
                            {%- if reusedDatasetsMap[relatedDatasetItem.typeOfDataset.relatedReusedDataset._uuid].reusedData -%}
                                {%- do reusedDatasetsMap[relatedDatasetItem.typeOfDataset.relatedReusedDataset._uuid].reusedData.tools.append(tool.uuid) -%}
                                {%- do tool.usedBy.append(relatedDatasetItem.typeOfDataset.relatedReusedDataset._uuid) -%}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endif -%}
                {%- endfor -%}
                {%- do result.dmp.sharedResources.tools.append(tool) -%}
            {%- endif -%}
        {%- endfor -%}
    {%- elif data.obj.areToolsForAccessReuse._value is sameas false -%}
        {%- do result.dmp.update({'noSpecialToolsReason': data.obj.areToolsForAccessReuse.noToolsForAccessReuseReason|default(None)}) -%}
    {%- endif -%}
{%- endif -%}

{# Mapping [Other outputs] #}
{%- do result.dmp.update({'areOtherOutputs': data.obj.areOtherOutputs|default(None)}) -%}
{%- do result.dmp.update({'outputsRetentionCriteriaDescription': data.obj.outputsRetentionCriteriaDescription|default(None)}) -%}
{%- if result.dmp.areOtherOutputs._value is sameas true -%}
    {%- if result.dmp.areOtherOutputs.areSwPackages._value is sameas true -%}
        {%- for swPackageItem in data.obj.areOtherOutputs.areSwPackages.swPackages -%}
            {%- set swPackage = {
                "name": swPackageItem.swPackage|default(None), 
                "isOpenLicense": swPackageItem.isOpenLicense|default(None),
                "whereAvailable": swPackageItem.whereAvailable|default(None),
                "isListedInCatalogue": swPackageItem.isListedInCatalogue|default(None),
            } -%}
            {%- if swPackage.isOpenLicense -%}
                {%- if swPackage.isOpenLicense._value is sameas true -%}
                    {%- if swPackageItem.isOpenLicense.openLicense -%}
                        {%- do swPackage.update({
                            "openSourceLicense": swPackageItem.isOpenLicense.openLicense|default(None),
                        }) -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endif -%}
            {%- do result.dmp.swPackages.append(swPackage) -%}
        {%- endfor -%}
    {%- endif -%}

    {%- if result.dmp.areOtherOutputs.areOtherOutputsNoSw._value is sameas true -%}
        {%- for otherOutputItem in data.obj.areOtherOutputs.areOtherOutputsNoSw.otherOutputs -%}
            {%- set otherOutput = {
            "description": otherOutputItem.description|default(None), 
            "whyImportant": otherOutputItem.whyImportant|default(None),
            "whoWillUse": otherOutputItem.whoWillUse|default(None),
            "isAvailable": otherOutputItem.isAvailable|default(None),
            "noAvailableReason": None,
            "whereAvailable": None,
        } -%}
        {%- if otherOutput.isAvailable._value is sameas true -%}
            {%- do otherOutput.update({
                "whereAvailable": otherOutputItem.isAvailable.whereAvailable|default(None),
            }) -%}
        {%- elif otherOutput.isAvailable._value is sameas false -%}
            {%- do otherOutput.update({
                "noAvailableReason": otherOutputItem.isAvailable.noAvailableReason|default(None),
            }) -%}
        {%- endif -%}
        {%- do result.dmp.otherOutputs.append(otherOutput) -%}
        {%- endfor -%}
    {%- endif -%}
{%- endif -%}
