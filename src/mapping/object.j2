                    {%- if ds.get("processingEnvironment") is none -%}
                        {%- do ds.update({"processingEnvironment": processingEnvironment.uuid}) -%}
                        {%- do usedBy.append(ds.uuid) -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}
