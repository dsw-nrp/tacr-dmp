        "isReuseRestrictionSpecified": reuseRestrictionItem.isReuseRestrictionSpecified|default(None),
        "reuseRestrictionSpecificationReason": None,
        "potentialDataUsers": reuseRestrictionItem.potentialDataUsers|default(None),
        "otherPotentialDataUsersUseCase": None,
        "accessRestriction": {
            "asOpenAsPossibleApproach": reuseRestrictionItem.accessRestriction.asOpenAsPossibleApproach|default(None),
            "canDataOpen": reuseRestrictionItem.accessRestriction.canDataOpen|default(None),
            "dataCannotOpen": {},
            "dataRightsArrangement": reuseRestrictionItem.accessRestriction.dataRightsArrangement|default(None),
            "isMetadataAvailable": reuseRestrictionItem.accessRestriction.isMetadataAvailable|default(None),
            "noMetadataAvailableReason": None,
            "isDocumentationAvailable": reuseRestrictionItem.accessRestriction.isDocumentationAvailable|default(None),
