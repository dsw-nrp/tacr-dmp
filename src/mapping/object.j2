{%- import "src/mapping/prepare-data.j2" as data with context -%}
{%- import "src/macros.html.j2" as macros with context -%}
{#- default object -#}
{%- set result = {
    "dmp": {
        "projects": [],
        "risks": [],
        "collaboration": {
            "contributors": [],
            "areCommunicationChannelsSet": None,
            "communicationChannels": None,
            "expertiseRequirement": None,
            "expertiseDetails": None,
            "trainingDetails": None,
        },
        "policies": [],
        "areSpecialToolsRequired": None,
        "noSpecialToolsReason": None,
        "reusingData": {
            "searchingProcess": None,
            "hasPreexistingData": None,
            "consideredDatasets": [],
        },
        "datasets": [],
        "outputsRetentionCriteriaDescription": None,
        "areOtherOutputs": None,
        "swPackages": [],
        "otherOutputs": [],
        "sharedResources": {
            "collections": [],
            "processingEnvironments": [],
            "metadataSpecifications": [],
            "reuseRestrictions": [],
            "organisationStrategies": [],
            "documentationSpecifications": [],
            "preservationStrategies": [],
            "dataStores": [],
            "tools": [],
        }
    },
    "meta": {
        "document": {
            "uuid": ctx.document.uuid,
            "name": ctx.document.name,
            "createdAt": ctx.document.createdAt,
        },
        "project": {
            "uuid": ctx.project.uuid,
            "name": ctx.project.name,
            "description": ctx.project.description,
            "tags": ctx.project.projectTags,
            "url": ctx.config.clientUrl ~ "/projects/" ~ ctx.project.uuid,
        },
    },
} -%}

{#- Mapping [Project Information] -#}
{%- set objectivesMap = {} -%}
{%- set projectsMap = {} -%}
{%- for projectItem in data.obj.projects -%}
    {%- set project = {
        "name": projectItem.name|default(None),
        "acronym": projectItem.acronym|default(None),
        "number": projectItem.number|default(None),
        "description": projectItem.abstract|default(None),
        "startDate": projectItem.startDate|default(None),
        "endDate": projectItem.endDate|default(None),
        "website": projectItem.website|default(None),
        "objectives": projectItem.objectives|map(attribute="objective")|list,
        "fundings": [],
        "costs": [],
    } -%}
    {%- for objective in projectItem.objectives -%}
        {%- do objectivesMap.update({objective._uuid: objective}) -%}
    {%- endfor -%}
    {%- if projectItem.fundings|length > 0 -%}
        {%- for fundingItem in projectItem.fundings -%}
            {%- set funding = {
                "grantId": fundingItem.grantId|default(None),
                "funder": fundingItem.funder|default(None),
                "status": fundingItem.status|default(None),
            } -%}
            {%- do project.fundings.append(funding) -%}
        {%- endfor -%}
    {%- endif -%}
    {%- if projectItem.costs|length > 0 -%}
        {%- for costItem in projectItem.costs -%}
            {%- set cost = {
                "title": costItem.title|default(None),
                "description": costItem.description|default(None),
                "amount": costItem.amount|default(None),
                "currency": costItem.currency|default(None),
                "allocation": costItem.allocation|map(attribute="_label")|list,
                "isCoveredByGrant": None,
                "coveredBy": None,
            } -%}
            {# Other than listed allocation #}
            {%- if costItem.allocationOther -%}
                {%- do cost.allocation.append(costItem.allocationOther._value) -%}
            {%- endif -%}
            {# Cover of costs #}
            {%- if costItem.coveredBy -%}
                {%- if costItem.coveredBy._value == "fundingGrant" -%}
                    {%- do cost.update({
                        "isCoveredByGrant": {"_value": true},
                        "coveredBy": costItem.coveredBy.grantId|default(None),
                    }) -%}
                {%- elif costItem.coveredBy._value == "other" -%}
                    {%- do cost.update({
                        "isCoveredByGrant": {"_value": false},
                        "coveredBy": costItem.coveredBy.other|default(None),
                    }) -%}
                {%- endif -%}
            {%- endif -%}
            {%- do project.costs.append(cost) -%}
        {%- endfor -%}
    {%- endif -%}
    {%- do result.dmp.projects.append(project) -%}
    {%- do projectsMap.update({projectItem._uuid: project}) -%}
{%- endfor -%}

{#- Mapping [Collaboration] -#}
{%- do result.dmp.collaboration.update ({
    "areCommunicationChannelsSet": data.obj.areCommunicationChannelsSet|default(None),
    "communicationChannels": None,
    "expertiseRequirement": data.obj.expertiseRequirement|default(None),
    "expertiseDetails": None,
    "trainingDetails": None,
}) -%}
{%- if result.dmp.collaboration.areCommunicationChannelsSet._value is sameas true -%}
    {%- do result.dmp.collaboration.update({
        "communicationChannels": data.obj.areCommunicationChannelsSet.communicationChannels|default(None),
    }) -%}
{%- endif -%}
{%- if result.dmp.collaboration.expertiseRequirement._value == "trainingExistingStaff" -%}
    {%- do result.dmp.collaboration.update({
        "trainingDetails": data.obj.expertiseRequirement.trainingDetails|default(None),
    }) -%}
{%- elif result.dmp.collaboration.expertiseRequirement._value == "hiringNewStaff" -%}
    {%- do result.dmp.collaboration.update({
        "expertiseDetails": data.obj.expertiseRequirement.expertiseDetails|default(None),
    }) -%}
{%- endif -%}

{#- Mapping [Contributors] -#}
{%- set contributorsMap = {} -%}
{%- for contributorItem in data.obj.contributors -%}
    {%- set contributor = {
        "uuid": contributorItem._uuid,
        "name": contributorItem.name|default(None),
        "orcid": contributorItem.orcid|default(None),
        "affiliation": contributorItem.affiliation|default(None),
        "email": contributorItem.email|default(None),
        "phone": contributorItem.phone|default(None),
        "isCreator": contributorItem.isCreator|default(None),
        "roles": contributorItem.roles|map(attribute="_label")|list,
        "projectsName": [],
    } -%}
    {%- if contributorItem.projects|length > 0 -%}
        {%- for project in contributorItem.projects -%}
            {%- if project.project and project.project._uuid in projectsMap -%}
                {%- set project_name = projectsMap[project.project._uuid].name._value if projectsMap[project.project._uuid].name else None -%}
                {%- if project_name is not none -%}
                    {%- do contributor.projectsName.append(project_name) -%}
                {%- endif -%}
            {%- endif -%}
        {%- endfor -%}
    {%- elif result.dmp.projects|length == 1 -%}
        {%- set project_name = result.dmp.projects[0].name._value if result.dmp.projects[0].name else None -%}
        {%- if project_name is not none -%}
            {%- do contributor.projectsName.append(project_name) -%}
        {%- endif -%}
    {%- endif -%}
    {%- do contributorsMap.update({contributor.uuid: contributor}) -%}
    {%- do result.dmp.collaboration.contributors.append(contributor) -%}
{%- endfor -%}

{#- Mapping [Risks] -#}
{%- for riskItem in data.obj.risks -%}
    {%- set risk = {
        "description": riskItem.description|default(None),
        "isMitigationPlanned": riskItem.isMitigationPlanned|default(None),
        "mitigationPlan": None,
    } -%}
    {%- if riskItem.isMitigationPlanned._value is sameas true -%}
        {%- do risk.update({
            "mitigationPlan": riskItem.isMitigationPlanned.mitigationPlan|default(None),
        }) -%}
    {%- endif -%}
    {%- do result.dmp.risks.append(risk) -%}
{%- endfor -%}

{# Mapping [Policies] #}
{%- for policyItem in data.obj.policies -%}
    {%- set policy = {
        "name": policyItem.name|default(None), 
        "description": policyItem.description|default(None),
        "url": policyItem.url|default(None),
        "scope": policyItem.scope|list,
    } -%}
    {%- if policyItem.otherScope -%}
        {%- do policy.scope.append({"_label": policyItem.otherScope._value}) -%}
    {%- endif -%}
    {%- do result.dmp.policies.append(policy) -%}
{%- endfor -%}

{# Mapping [Reusing Data] #}
{%- set reusedDatasetsMap = {} -%}
{%- set reusingData = result.dmp.reusingData -%}
{%- do reusingData.update({
    "searchingProcess": data.obj.searchingProcess|default(None),
    "hasPreexistingData": data.obj.hasPreexistingData|default(None),
    "consideredDatasets": [],
}) -%}
{%- if reusingData.hasPreexistingData._value is sameas true -%}
    {%- for consideredDataItem in data.obj.hasPreexistingData.consideredData -%}
        {%- set consideredData = {
            "uuid": consideredDataItem._uuid,
            "name": consideredDataItem.name|default(None),
            "hasIdentifier": consideredDataItem.hasIdentifier|default(None),
            "identifier": {},
            "noIdentifierReason": None,
            "isReused": consideredDataItem.isReused|default(None),
            "reusedData": {},
            "noReusedReason": None,
        }-%}
        {%- if consideredData.hasIdentifier._value is sameas true -%}
            {%- do consideredData.identifier.update({
                "value": consideredDataItem.hasIdentifier.identifier|default(None),
                "type": consideredDataItem.hasIdentifier.type|default(None),
            }) -%}
        {%- elif consideredData.hasIdentifier._value is sameas false -%}
            {%- do consideredData.update({
                "noIdentifierReason": consideredDataItem.hasIdentifier.noIdentifierReason|default(None),
            }) -%}
        {%- endif -%}
        {%- if consideredData.isReused._value is sameas true -%}
                {%- do consideredData.update({
                    "reusedData": {
                        "uuid" : consideredDataItem._uuid,
                        "maintainer": consideredDataItem.isReused.maintainer|default(None),
                        "dataVolume": consideredDataItem.isReused.dataVolume|default(None),
                        "purpose": consideredDataItem.isReused.purpose|default(None),
                        "conditions": consideredDataItem.isReused.conditions|default(None), 
                        "tools": [],
                        "isVersioned": consideredDataItem.isReused.isVersioned|default(None),
                        "versionStrategy": {},
                        "isFormattingKnown": consideredDataItem.isReused.knownFormatting|default(None),
                        "formatting": {},
                        "users": [],
                    },
                }) -%}
                {%- set reusedData = consideredData.reusedData -%}
                {%- if reusedData.conditions._value == "other" -%}
                    {%- do reusedData.update({
                        "conditions": consideredDataItem.isReused.conditions.other|default(None),
                    }) -%}
                {%- endif -%}
                {%- if reusedData.isVersioned._value is sameas true -%}
                    {%- do reusedData.update({
                        "versionStrategy": {
                            "usedVersion": consideredDataItem.isReused.isVersioned.usedVersion|default(None),
                            "versioningProcess": consideredDataItem.isReused.isVersioned.versioningProcess|default(None),
                        },
                    }) -%}
                {%- elif reusedData.isVersioned._value is sameas false -%}
                    {%- do reusedData.update({
                        "versionStrategy": None,
                    }) -%}
                {%- endif -%}
                {%- if reusedData.isFormattingKnown._value is sameas true -%}
                    {%- do reusedData.formatting.update({
                        "formats": consideredDataItem.isReused.knownFormatting.formats|map(attribute="format")|list,
                        "isUsableAsIs": consideredDataItem.isReused.knownFormatting.isUsableAsIs|default(None),
                    }) -%}
                {%- endif -%}
                {%- if consideredDataItem.isReused.users -%}
                    {%- for user in consideredDataItem.isReused.users -%}
                        {%- if user.user and user.user._uuid in contributorsMap -%}
                            {%- do reusedData.users.append(contributorsMap[user.user._uuid]) -%}
                        {%- endif -%}
                    {%- endfor -%}
                {%- endif -%}
        {%- elif consideredData.isReused._value is sameas false -%}
            {%- do consideredData.update({
                "noReusedReason": consideredDataItem.isReused.noReusedReason|default(None),
            }) -%}
            {%- if consideredData.noReusedReason._value == "other" -%}
                {%- do consideredData.noReusedReason.update({"_value": consideredDataItem.isReused.noReusedReason.other._value|default(None)}) -%}
            {%- endif -%}
        {%- endif -%}
        {%- do reusingData.consideredDatasets.append(consideredData) -%}
        {%- do reusedDatasetsMap.update({consideredData.uuid: consideredData}) -%}
    {%- endfor -%}
{%- endif -%}

{# Mapping [Dataset] #}
{%- set datasetsMap = {} -%}
{%- for datasetItem in data.obj.datasets -%}
    {%- set dataset = {
        "uuid": datasetItem._uuid,
        "name": datasetItem.name|default(None),
        "description": datasetItem.description|default(None),
        "identifiers": [],
        "keywords": datasetItem.keywords|map(attribute="keyword")|list,
        "type": datasetItem.type|default(None),
        "purposes": [],
        "issueDate": datasetItem.issueDate|default(None),
        "language": datasetItem.language|default(None),
        "citation": datasetItem.citation|default(None),
        "willBePublished": datasetItem.willBePublished|default(None),
        "qualifiedReferences": [],
        "distributions": [],
        "tools": [],
        "creators": [],
    } -%}
    {%- if datasetItem.identifiers|length > 0 -%}
        {%- for identifierItem in datasetItem.identifiers -%}
            {%- set identifier = {
                "type": identifierItem.type|default(None),
                "value": identifierItem.value|default(None),
            } -%}
            {%- do dataset.identifiers.append(identifier) -%}
        {%- endfor -%}
    {%- endif -%}
    {%- if dataset.willBePublished._value is sameas false -%}
        {%- do dataset.update({
            "noPlannedPublishedReason": datasetItem.willBePublished.noPlannedPublishedReason|default(None),
        }) -%}
    {%- elif dataset.willBePublished._value is sameas true -%}
        {%- do dataset.update({
            "isCompletePublished": datasetItem.willBePublished.isCompletePublished|default(None),
        }) -%}
        {%- if dataset.isCompletePublished._value is sameas false -%}
            {%- do dataset.update({
                "partialPublishedDetails": datasetItem.willBePublished.isCompletePublished.partialPublishedDetails|default(None),
            }) -%}
        {%- endif -%}
        {%- do dataset.update({
            "isPublished": datasetItem.willBePublished.isPublished|default(None),
        }) -%}
        {%- do dataset.update({"hasPublisher": datasetItem.willBePublished.publisher}) -%}
    {%- endif -%}
    {%- for purpose in datasetItem.purposes -%}
        {%- if purpose.purpose and purpose.purpose._uuid in objectivesMap and objectivesMap[purpose.purpose._uuid].objective -%}
            {%- do dataset.purposes.append(objectivesMap[purpose.purpose._uuid].objective) -%}
        {%- endif -%}
    {%- endfor -%}
    {%- for qualifiedReferenceItem in datasetItem.qualifiedReferences -%}
        {%- set qualifiedReference = ({
            "identifier": {
                "type": qualifiedReferenceItem.type|default(None),
                "value": qualifiedReferenceItem.value|default(None),
            },
            "relationship": qualifiedReferenceItem.relationship|default(None),
        }) -%}
        {%- do dataset.qualifiedReferences.append(qualifiedReference) -%}
    {%- endfor -%}
    {%- for creator in datasetItem.creatorsList -%}
        {%- if creator.creator and creator.creator._uuid in contributorsMap -%}
            {%- do dataset.creators.append(contributorsMap[creator.creator._uuid]) -%}
        {%- endif -%}
    {%- endfor -%}
    {%- do result.dmp.datasets.append(dataset) -%}
    {%- do datasetsMap.update({dataset.uuid: dataset}) -%}
{%- endfor -%}

{# Mapping [Data Collection] #}
{%- for collectionItem in data.obj.collections -%}
    {%- set collection = {
        "uuid": collectionItem._uuid,
        "isPlanned": collectionItem.isPlanned|default(None),
        "startDate": collectionItem.startDate|default(None),
        "endDate": collectionItem.endDate|default(None),
        "dateCreated" : collectionItem.dateCreated|default(None),
        "isEquipmentCollection": collectionItem.isEquipmentCollection|default(None),
        "equipmentCollection": {},
        "isNonEquipmentCollection":collectionItem.isNonEquipmentCollection|default(None),
        "nonEquipmentCollection": {},
        "isPhysicalSamplesCollection": collectionItem.isPhysicalSamplesCollection|default(None),
        "physicalSamplesCollection": {},
        "isMonitoringIntegrityAfterCollection": collectionItem.isMonitoringIntegrityAfterCollection|default(None),
        "monitoringIntegrityAfterCollection": [],
        "isMonitoringIntegrityAfterProcessing": collectionItem.isMonitoringIntegrityAfterProcessing|default(None),
        "monitoringIntegrityAfterProcessing": [],
        "isSensitiveDataCollection": collectionItem.isSensitiveDataCollection|default(None),
        "sensitiveDataCollection": {},
        "isSubjectToEthicalReview": collectionItem.isSubjectToEthicalReview|default(None),
        "ethicalReview": {},
    } -%}

    {# Mapping [Equipment Collection] #}
    {%- if collection.isEquipmentCollection._value is sameas true -%}
        {%- do collection.equipmentCollection.update({
            "whoMeasures": collectionItem.isEquipmentCollection.whoMeasures|default(None),
            "externalPartyControlOverData": None,
            "externalPartyResponsibility": None,
            "instruments": [],
            "requiresRawDataPreparation": collectionItem.isEquipmentCollection.requiresRawDataPreparation|default(None),
            "rawDataPreparation": {},
            "formats": collectionItem.isEquipmentCollection.formats|map(attribute="format")|list,
            "usesQualityProcesses": collectionItem.isEquipmentCollection.usesQualityProcesses|default(None),
            "qualityProcesses": {},
            "unitsOfMeasurement": [],
        }) -%}
        {%- if collection.equipmentCollection.whoMeasures._value == "external_party" -%}
            {%- do collection.equipmentCollection.update({
                    "externalPartyControlOverData": collectionItem.isEquipmentCollection.whoMeasures.controlOverData|default(None),
                    "externalPartyResponsibility": collectionItem.isEquipmentCollection.whoMeasures.externalPartyResponsibility|default(None),
            }) -%}
            {%- if collection.equipmentCollection.externalPartyControlOverData._value == "other" -%}
                {%- do  collection.equipmentCollection.update({
                    "externalPartyControlOverData": collectionItem.isEquipmentCollection.whoMeasures.controlOverData.other|default(None),
                }) -%}
            {%- endif -%}
            {%- if collection.equipmentCollection.externalPartyResponsibility._value == "other" -%}
                {%- do  collection.equipmentCollection.update({
                    "externalPartyResponsibility": collectionItem.isEquipmentCollection.whoMeasures.externalPartyResponsibility.other|default(None),
                }) -%}
            {%- endif -%}      
        {%- endif -%}
        {%- for instrumentItem in collectionItem.isEquipmentCollection.instruments -%}
            {%- set instrument = {
                "name": instrumentItem.name|default(None),
                "description": instrumentItem.description|default(None),
                "isStandard": instrumentItem.isStandard|default(None),
                "url": instrumentItem.url|default(None),
            } -%}
            {%- do collection.equipmentCollection.instruments.append(instrument) -%}
        {%- endfor -%}
        {%- if collection.equipmentCollection.requiresRawDataPreparation._value is sameas true-%}
            {%- do collection.equipmentCollection.rawDataPreparation.update({
                "integrityEnsured": collectionItem.isEquipmentCollection.requiresRawDataPreparation.integrityEnsured|default(None),
                "securityEndured": collectionItem.isEquipmentCollection.requiresRawDataPreparation.securityEndured|default(None),
                "formats": [],
                "requiresFormatConversion": collectionItem.isEquipmentCollection.requiresRawDataPreparation.requiresFormatConversion|default(None),
                "newFormats": [],
            }) -%}
            {%- for format in collectionItem.isEquipmentCollection.requiresRawDataPreparation.formats -%}
                {%- do collection.equipmentCollection.rawDataPreparation.formats.append(format) -%}
            {%- endfor -%}
            {%- if collection.equipmentCollection.rawDataPreparation.requiresFormatConversion is sameas true -%}
                {%- for newFormat in collectionItem.isEquipmentCollection.requiresRawDataPreparation.newFormats -%}
                    {%- do collection.equipmentCollection.rawDataPreparation.newFormats.append(newFormat) -%}
                {%- endfor -%}
            {%- endif -%}
        {%- endif -%}
        {%- for unitOfMeasurement in collectionItem.isEquipmentCollection.unitsOfMeasurements -%}
            {%- do collection.equipmentCollection.unitsOfMeasurements.append(unitOfMeasurement) -%}
        {%- endfor -%}
        {%- if collection.equipmentCollection.usesQualityProcesses._value is sameas true -%}
            {%- do collection.equipmentCollection.qualityProcesses.update({
                "calibration": collectionItem.isEquipmentCollection.usesQualityProcesses.calibration|default(None),
                "repeatSamples": collectionItem.isEquipmentCollection.usesQualityProcesses.repeatSamples|default(None),
                "standardizedMethods": collectionItem.isEquipmentCollection.usesQualityProcesses.standardizedMethods|default(None),
                "dataEntryValidation": collectionItem.isEquipmentCollection.usesQualityProcesses.dataEntryValidation|default(None),
                "dataPeerReview": collectionItem.isEquipmentCollection.usesQualityProcesses.dataPeerReview|default(None),
                "usesControlledVocabularies": collectionItem.isEquipmentCollection.usesQualityProcesses.usesControlledVocabularies|default(None),
                "knownOutcomeSamples": collectionItem.isEquipmentCollection.usesQualityProcesses.knownOutcomeSamples|default(None),
                "otherQualityProcesses": collectionItem.isEquipmentCollection.usesQualityProcesses.otherQualityProcesses|default(None),
            }) -%}
            {%- if collection.equipmentCollection.qualityProcesses.otherQualityProcesses._value is sameas true -%}
                {%- do collection.equipmentCollection.qualityProcesses.update({
                    "otherQualityProcesses": collectionItem.isEquipmentCollection.usesQualityProcesses.otherQualityProcesses.other|default(None),
                }) -%}
            {%- endif -%}
        {%- endif -%}
    {%- endif -%}

    {# Mapping [NonEquipment Collection] #}
    {%- if collection.isNonEquipmentCollection._value is sameas true -%}
        {%- do collection.nonEquipmentCollection.update({
            "usesQuestionnaires": collectionItem.isNonEquipmentCollection.usesQuestionnaires|default(None),
            "usesReportsForms": collectionItem.isNonEquipmentCollection.usesReportsForms|default(None),
            "usesPatientRecords": collectionItem.isNonEquipmentCollection.usesPatientRecords|default(None),
            "usesOtherForms": None,
            "initialCaptureMethod": collectionItem.isNonEquipmentCollection.initialCaptureMethod|default(None),
            "dataNonDigitalEntryResponsibleParty": None, 
            "isDigitalAvailabilityArranged": None,
            "isCollectedBySinglePerson": collectionItem.isNonEquipmentCollection.isCollectedBySinglePerson|default(None),
            "subjectivityRiskHandling": None,
            "unitsOfMeasurement": [],
        }) -%}
        {%- if collectionItem.isNonEquipmentCollection.usesOtherForms._value is sameas true and collectionItem.isNonEquipmentCollection.usesOtherForms.otherForms._value -%}
            {%- do collection.nonEquipmentCollection.update({
                "usesOtherForms": collectionItem.isNonEquipmentCollection.usesOtherForms.otherForms|default(None),
            }) -%}
        {%- endif -%}
        {%- if collection.nonEquipmentCollection.initialCaptureMethod._value == "manual" -%}
            {%- do collection.nonEquipmentCollection.update({
                "dataNonDigitalEntryResponsibleParty": collectionItem.isNonEquipmentCollection.initialCaptureMethod.dataNonDigitalEntryResponsibleParty|default(None),
                "isDigitalAvailabilityArranged": collectionItem.isNonEquipmentCollection.initialCaptureMethod.isDigitalAvailabilityArranged|default(None),
            }) -%}
            {%- if collection.nonEquipmentCollection.dataNonDigitalEntryResponsibleParty._value == "team_member" -%}
                {%- do collection.nonEquipmentCollection.update({
                    "dataNonDigitalEntryResponsibleParty": [],
                }) -%}
                {%- for user in collectionItem.isNonEquipmentCollection.initialCaptureMethod.dataNonDigitalEntryResponsibleParty.projectTeamMembers-%}
                    {%- if user.user and user.user._uuid in contributorsMap -%}
                        {%- do collection.nonEquipmentCollection.dataNonDigitalEntryResponsibleParty.append(contributorsMap[user.user._uuid]) -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- elif collection.nonEquipmentCollection.dataNonDigitalEntryResponsibleParty._value == "other" -%}
                {%- do collection.nonEquipmentCollection.update({
                    "dataNonDigitalEntryResponsibleParty": collectionItem.isNonEquipmentCollection.initialCaptureMethod.dataNonDigitalEntryResponsibleParty.other|default(None),
                }) -%}
            {%- endif -%}
        {%- elif collection.nonEquipmentCollection.initialCaptureMethod._value == "digital" -%}
            {%- do collection.nonEquipmentCollection.update({
                "dataNonDigitalEntryResponsibleParty": None,
                "isDigitalAvailabilityArranged": True,
            }) -%}
        {%- endif -%}
        {%- if collection.nonEquipmentCollection.isCollectedBySinglePerson._value is sameas true -%}
            {%- do collection.nonEquipmentCollection.update({
                "subjectivityRiskHandling": collectionItem.isNonEquipmentCollection.isCollectedBySinglePerson.subjectivityRiskHandling|default(None),
            }) -%}
            {%- if collection.nonEquipmentCollection.subjectivityRiskHandling._value == "other" -%}
                {%- do collection.nonEquipmentCollection.update({
                    "subjectivityRiskHandling": collectionItem.isNonEquipmentCollection.isCollectedBySinglePerson.subjectivityRiskHandling.other|default(None),
                }) -%}
            {%- endif -%}
        {%- endif -%}
        {%- for unitOfMeasurement in collectionItem.isNonEquipmentCollection.unitsOfMeasurements -%}
            {%- do collection.nonEquipmentCollection.unitsOfMeasurements.append(unitOfMeasurement) -%}
        {%- endfor -%}
    {%- endif -%}

    {# Mapping [Physical Samples Collection] #}
    {%- if collection.isPhysicalSamplesCollection._value is sameas true -%}
        {%- do collection.physicalSamplesCollection.update({
            "storesPhysicalSamples": collectionItem.isPhysicalSamplesCollection.storesPhysicalSamples|default(None),
            "physicalSamplesStorage": {},
            "unitsOfMeasurement": [],
        }) -%}
        {%- if collection.physicalSamplesCollection.storesPhysicalSamples._value is sameas true -%}
            {%- do collection.physicalSamplesCollection.physicalSamplesStorage.update({
