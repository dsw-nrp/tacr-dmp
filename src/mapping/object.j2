            {%- if preservationStrategy.longTermStorageDuringProject.archiveSecurity.isEncrypted._value is sameas true -%}
                {%- do preservationStrategy.longTermStorageDuringProject.archiveSecurity.update({
                    "isKeyAccessClearlyDefined": preservationItem.usesLongTermStorageDuringProject.isArchiveSecurityProvided.isEncrypted.isKeyAccessClearlyDefined|default(None),
                }) -%}
            {%- endif -%}
        {%- endif -%}
        {%- if preservationStrategy.longTermStorageDuringProject.isArchiveAccessOnlineRequired._value is sameas true -%}
            {%- do preservationStrategy.longTermStorageDuringProject.archiveAccessOnline.update({
                "isDataIntegrityGuaranteed": preservationItem.usesLongTermStorageDuringProject.isArchiveAccessOnlineRequired.isDataIntegrityGuaranteed|default(None),
                "isAccessRequestProcessDefined": preservationItem.usesLongTermStorageDuringProject.isArchiveAccessOnlineRequired.isAccessRequestProcessDefined|default(None),
            }) -%}
        {%- endif -%}
        {%- if preservationStrategy.longTermStorageDuringProject.isArchiveAccessDecided._value is sameas true -%}
            {%- do preservationStrategy.longTermStorageDuringProject.archiveAccess.update({
                "isRestoreRequesterDefined": preservationItem.usesLongTermStorageDuringProject.isArchiveAccessDecided.isRestoreRequesterDefined|default(None),
                "isRestoreTimeManageableForLargeData": preservationItem.usesLongTermStorageDuringProject.isArchiveAccessDecided.isRestoreTimeManageableForLargeData|default(None),
                "isPostProjectDataAuthorityDefined": preservationItem.usesLongTermStorageDuringProject.isArchiveAccessDecided.isPostProjectDataAuthorityDefined|default(None),
            }) -%}
        {%- endif -%}
        {%- if preservationStrategy.longTermStorageDuringProject.isArchivePeriodDefined._value is sameas true -%}
            {%- do preservationStrategy.longTermStorageDuringProject.update({
                "archivePeriod": preservationItem.usesLongTermStorageDuringProject.isArchivePeriodDefined.archivePeriod|default(None),
            }) -%}
            {%- if preservationStrategy.longTermStorageDuringProject.archivePeriod._value == "fixed" -%}
                {%- do preservationStrategy.longTermStorageDuringProject.update({
                    "archivePeriod": preservationItem.usesLongTermStorageDuringProject.isArchivePeriodDefined.archivePeriod.exactArchivePeriod|default(None),
                }) -%}
            {%- endif -%}
        {%- endif -%}
    {%- elif preservationStrategy.usesLongTermStorageDuringProject._value is sameas false -%}
        {%- do preservationStrategy.noLongTermStorageDuringProject.update({
            "canRegenerateOriginalData": preservationItem.usesLongTermStorageDuringProject.canRegenerateOriginalData|default(None),
            "rawDataArchivalTime": preservationItem.usesLongTermStorageDuringProject.rawDataArchivalTime|default(None),
        }) -%}
    {%- endif -%}
    {%- if preservationStrategy.usesLongTermStorageAfterProject._value is sameas true -%}
        {%- do preservationStrategy.longTermStorageAfterProject.update({
            "funder": preservationItem.usesLongTermStorageAfterProject.funder|default(None),
            "minimumLifeTimeYears": preservationItem.usesLongTermStorageAfterProject.minimumLifeTime|default(None),
            "minimumLifeTimeOther": None,
            "isArchivalPeriodExtendable": preservationItem.usesLongTermStorageAfterProject.isArchivalPeriodExtendable|default(None),
            "archivalPeriodExtension": {},
            "noArchivalPeriodExtensionReason": None,
            "isFormatUpgradePlanned": preservationItem.usesLongTermStorageAfterProject.isFormatUpgradePlanned|default(None),
            "isMediaUpgradePlanned": preservationItem.usesLongTermStorageAfterProject.isMediaUpgradePlanned|default(None),
        }) -%}
        {%- if preservationStrategy.longTermStorageAfterProject.minimumLifeTimeYears._value == "other_period" -%}
            {%- do preservationStrategy.longTermStorageAfterProject.update({
                "minimumLifeTimeYears": preservationItem.usesLongTermStorageAfterProject.minimumLifeTime.otherPeriod|default(None),
            }) -%}
        {%- elif preservationStrategy.longTermStorageAfterProject.minimumLifeTimeYears._value == "other_way"  -%}
            {%- do preservationStrategy.longTermStorageAfterProject.update({
                "minimumLifeTimeYears": None,
                "minimumLifeTimeOther": preservationItem.usesLongTermStorageAfterProject.minimumLifeTime.other|default(None),
            }) -%}
        {%- endif -%}
        {%- if preservationStrategy.longTermStorageAfterProject.isArchivalPeriodExtendable._value is sameas true -%}
            {%- do preservationStrategy.longTermStorageAfterProject.archivalPeriodExtension.update({
                "archivalExtensionDecisionMaker": preservationItem.usesLongTermStorageAfterProject.isArchivalPeriodExtendable.archivalExtensionDecisionMaker|default(None),
                "archivalExtensionDecisionCriteria": preservationItem.usesLongTermStorageAfterProject.isArchivalPeriodExtendable.archivalExtensionDecisionCriteria|map(attribute="_value")|list,
            }) -%}
            {%- if preservationStrategy.longTermStorageAfterProject.archivalPeriodExtension.archivalExtensionDecisionMaker._value == "other" -%}
                {%- do preservationStrategy.longTermStorageAfterProject.archivalPeriodExtension.update({
                    "archivalExtensionDecisionMaker": preservationItem.usesLongTermStorageAfterProject.isArchivalPeriodExtendable.archivalExtensionDecisionMaker.other|default(None),
                }) -%}
            {%- endif -%}
        {%- elif preservationStrategy.longTermStorageAfterProject.isArchivalPeriodExtendable._value is sameas false -%}
            {%- do preservationStrategy.longTermStorageAfterProject.update({
                "noArchivalPeriodExtensionReason": preservationItem.usesLongTermStorageAfterProject.isArchivalPeriodExtendable.noArchivalPeriodExtensionReason|default(None),
            }) -%}
        {%- endif -%}
    {%- elif preservationStrategy.usesLongTermStorageAfterProject._value is sameas false -%}
        {%- do preservationStrategy.update({
            "noLongTermStorageAfterProjectReason": preservationItem.usesLongTermStorageAfterProject.noLongTermStorageAfterProjectReason|default(None),
        }) -%}
    {%- endif -%}

    {%- if preservationStrategy.isPreservationStatementDefined._value is sameas true -%}
        {%- do preservationStrategy.preservationStatement.update({
            "description": preservationItem.isPreservationStatementDefined.description|default(None),
            "documentLink": preservationItem.isPreservationStatementDefined.documentLink|default(None),
            "document": preservationItem.isPreservationStatementDefined.document|default(None),
        }) -%}
    {%- endif -%}

    {# what datasets? #}
    {%- set usedBy = [] -%}

    {%- if preservationItem.isPlanned._value is sameas false -%}
        {%- if preservationItem.isPlanned.isForAllDatasets._value is sameas true -%}
            {# Assign to all datasets #}
            {%- for dataset in result.dmp.datasets -%}
                {%- if dataset.get("preservationStrategy") is none -%}
                    {%- do dataset.update({"preservationStrategy": preservationStrategy.uuid}) -%}
                    {%- do usedBy.append(dataset.uuid) -%}
                {%- endif -%}
            {%- endfor -%}

        {%- elif preservationItem.isPlanned.isForAllDatasets._value is sameas false -%}
            {# Assign to related datasets #}
            {%- for relatedDataset in preservationItem.isPlanned.isForAllDatasets.relatedDatasets -%}
                {%- if relatedDataset.relatedDataset and relatedDataset.relatedDataset._uuid in datasetsMap -%}
                    {%- set ds = datasetsMap[relatedDataset.relatedDataset._uuid] -%}
                    {%- if ds.get("preservationStrategy") is none -%}
                        {%- do ds.update({"preservationStrategy": preservationStrategy.uuid}) -%}
                        {%- do usedBy.append(ds.uuid) -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endif -%}

        {# assign usedBy to preservationStrategy #}
        {%- do preservationStrategy.update({"usedBy": usedBy}) -%}
        {%- do result.dmp.sharedResources.preservationStrategies.append(preservationStrategy) -%}
        
    {%- elif preservationItem.isPlanned._value is sameas true -%}
        {%- do preservationStrategy.update({"usedBy": usedBy}) -%}
        {%- do result.dmp.sharedResources.preservationStrategies.append(preservationStrategy) -%}
    {%- endif -%}
{%- endfor -%}

