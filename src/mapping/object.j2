                    "humanErrorRecoveryPlan": preservationItem.usesLongTermStorageDuringProject.isDataChangingOverTime.usesBackupsForHumanErrorRecovery.humanErrorRecoveryPlan|default(None),
                }) -%}
            {%- endif -%}
        {%- endif -%}
        {%- if preservationStrategy.longTermStorageDuringProject.isArchiveSecurityProvided._value is sameas true -%}
            {%- do preservationStrategy.longTermStorageDuringProject.archiveSecurity.update({
