        }) -%}
        {%- if reuseRestriction.isReuseRestrictionSpecified.other._value -%}
            {%- do reuseRestriction.reuseRestrictionSpecificationReason.append(reuseRestrictionItem.isReuseRestrictionSpecified.other._value|default(None)) -%}
        {%- endif -%}
    {%- endif -%}
    {%- if reuseRestriction.potentialDataUsers._value == "other_domain" -%}
        {%- do reuseRestriction.update({
            "otherPotentialDataUsersUseCase": reuseRestrictionItem.potentialDataUsers.other|default(None),
        }) -%}
    {%- endif -%}
    {%- if reuseRestriction.accessRestriction.canDataOpen._value is sameas false -%}
        {%- do reuseRestriction.accessRestriction.dataCannotOpen.update({
            "isLegalReason": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason|default(None),
            "legalReason": {},
            "isBusinessReason": reuseRestrictionItem.accessRestriction.canDataOpen.isBusinessReason|default(None),
            "businessReason": None,
            "isOtherReason": reuseRestrictionItem.accessRestriction.canDataOpen.isOtherReason|default(None),
