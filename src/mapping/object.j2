            {# Assign to all datasets #}
            {%- for dataset in result.dmp.datasets -%}
                {%- if dataset.get("collection") is none -%}
                    {%- do dataset.update({"collection": collection.uuid}) -%}
                    {%- do usedBy.append(dataset.uuid) -%}
                {%- endif -%}
            {%- endfor -%}

        {%- elif collectionItem.isPlanned.isForAllDatasets._value is sameas false -%}
            {# Assign to related datasets #}
            {%- for relatedDataset in collectionItem.isPlanned.isForAllDatasets.relatedDatasets -%}
                {%- if relatedDataset.relatedDataset and relatedDataset.relatedDataset._uuid in datasetsMap -%}
                    {%- set ds = datasetsMap[relatedDataset.relatedDataset._uuid] -%}
                    {%- if ds.get("collection") is none -%}
                        {%- do ds.update({"collection": collection.uuid}) -%}
                        {%- do usedBy.append(ds.uuid) -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endif -%}

        {# assign usedBy to collection #}
        {%- do collection.update({"usedBy": usedBy}) -%}
        {%- do result.dmp.sharedResources.collections.append(collection) -%}

