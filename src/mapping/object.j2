                {%- do reuseRestriction.accessRestriction.dataCannotOpen.legalReason.privacyReason.update({
                    "locationOfData": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isPrivacyReason.locationOfData|default(None),
                    "howToMoreOpen": {
                        "pseudonymization": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isPrivacyReason.pseudonymization|default(None),
                        "useThirdPartyForPseudonymization": None,
                        "anonymization": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isPrivacyReason.anonymization|default(None),
