                    {%- do reuseRestriction.accessRestriction.dataCannotOpen.legalReason.privacyReason.howToMoreOpen.update({
                        "useThirdPartyForPseudonymization": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isPrivacyReason.pseudonymization.useThirdPartyForPseudonymization|default(None),
                    }) -%}
                {%- endif -%}
            {%- endif -%}
            {%- if reuseRestriction.accessRestriction.dataCannotOpen.legalReason.isIntellectualPropertyReason._value is sameas true -%}
                {%- do reuseRestriction.accessRestriction.dataCannotOpen.legalReason.intellectualPropertyReason.update({
                    "isOwnershipOfDataDefined": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isIntellectualPropertyReason.isOwnershipOfDataDefined|default(None),
                    "isDecisionPowerOfMovingDataDefined": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isIntellectualPropertyReason.isDecisionPowerOfMovingDataDefined|default(None),
                }) -%}
            {%- endif -%}
            {%- if reuseRestriction.accessRestriction.dataCannotOpen.legalReason.isAuthenticatedAccess._value is sameas true -%}
                {%- do reuseRestriction.accessRestriction.dataCannotOpen.legalReason.authenticatedAccess.update({
                    "dataStorage": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isAuthenticatedAccess.dataStorage|default(None),
                    "authenticationProcess": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isAuthenticatedAccess.authenticationProcess|default(None),
                    "whoAuthenticate": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isAuthenticatedAccess.whoAuthenticate|default(None),
                    "whoAuthenticateOther": None,
                    "authenticationCriteriaAvailable": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isAuthenticatedAccess.authenticationCriteriaAvailable|default(None),
                    "auditingForReuseArranged": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isAuthenticatedAccess.auditingForReuseArranged|default(None),
                }) -%}
                {%- if reuseRestriction.accessRestriction.dataCannotOpen.legalReason.authenticatedAccess.authenticationProcess._value == "other"  -%}
                    {%- do reuseRestriction.accessRestriction.dataCannotOpen.legalReason.authenticatedAccess.update({
                        "authenticationProcess": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isAuthenticatedAccess.authenticationProcess.other|default(None),
                    }) -%}
                {%- endif -%}
                {%- if reuseRestriction.accessRestriction.dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticate._value == "existing_data_access_committee"  -%}
                    {%- do reuseRestriction.accessRestriction.dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticate.update({
                        "dataAccessCommittee": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isAuthenticatedAccess.whoAuthenticate.dataAccessCommitte|default(None),
                    }) -%}
                {%- elif reuseRestriction.accessRestriction.dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticate._value == "other"  -%}
                    {%- do reuseRestriction.accessRestriction.dataCannotOpen.legalReason.authenticatedAccess.update({
                        "whoAuthenticateOther": reuseRestrictionItem.accessRestriction.canDataOpen.isLegalReason.isAuthenticatedAccess.whoAuthenticate.other|default(None),
                    }) -%}
                {%- endif -%}
            {%- endif -%}
        {%- endif -%}
        {%- if reuseRestriction.accessRestriction.dataCannotOpen.isBusinessReason._value == "yes_other" -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.isBusinessReason.update({"_value": true}) -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.update({
            "businessReason": reuseRestrictionItem.accessRestriction.canDataOpen.isBusinessReason.other|default(None),
            }) -%}
        {%- elif reuseRestriction.accessRestriction.dataCannotOpen.isBusinessReason._value  == "yes_patents" -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.isBusinessReason.update({"_value": true}) -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.update({
            "businessReason": "patents",
            }) -%}
        {%- elif reuseRestriction.accessRestriction.dataCannotOpen.isBusinessReason._value  == "no" -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.isBusinessReason.update({"_value": false}) -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.update({
            "businessReason": None,
            }) -%}
        {%- endif -%}
        {%- if reuseRestriction.accessRestriction.dataCannotOpen.isOtherReason._value == "yes_other" -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.isOtherReason.update({"_value": true}) -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.update({
            "otherReason": reuseRestrictionItem.accessRestriction.canDataOpen.isOtherReason.other|default(None),
            }) -%}
        {%- elif reuseRestriction.accessRestriction.dataCannotOpen.isOtherReason._value == "yes_papers" -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.isOtherReason.update({"_value": true}) -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.update({
            "otherReason": "papers",
            }) -%}
        {%- elif reuseRestriction.accessRestriction.dataCannotOpen.isOtherReason._value == "no" -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.isOtherReason.update({"_value": false}) -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.update({
            "otherReason": None,
            }) -%}
        {%- endif -%}
        {%- if reuseRestriction.accessRestriction.dataCannotOpen.isAccessProcessDefined._value is sameas true -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.accessProcess.update({
                "description": reuseRestrictionItem.accessRestriction.canDataOpen.isAccessProcessDefined.description|default(None),
                "timeFrame": reuseRestrictionItem.accessRestriction.canDataOpen.isAccessProcessDefined.timeFrame|default(None),
                "isExpectedCost": reuseRestrictionItem.accessRestriction.canDataOpen.isAccessProcessDefined.isExpectedCost|default(None),
                "expectedCost": None,
                "currency": None,
            })  -%}
            {%- if reuseRestriction.accessRestriction.dataCannotOpen.accessProcess.isExpectedCost._value is sameas true -%}
                {%- do reuseRestriction.accessRestriction.dataCannotOpen.accessProcess.update({
                    "expectedCost": reuseRestrictionItem.accessRestriction.canDataOpen.isAccessProcessDefined.isExpectedCost.expectedCost|default(None),
                    "currency": reuseRestrictionItem.accessRestriction.canDataOpen.isAccessProcessDefined.isExpectedCost.currency|default(None),
                }) -%}
            {%- endif -%}
        {%- endif -%}
        {%- if reuseRestriction.accessRestriction.dataCannotOpen.isDataSharingAgreementRequired._value is sameas true -%}
            {%- do reuseRestriction.accessRestriction.dataCannotOpen.dataSharingAgreement.update({
                "isDefined": reuseRestrictionItem.accessRestriction.canDataOpen.isDataSharingAgreementRequired.isDefined|default(None),
                "description": None,
                "documentLink": None,
                "document": None,
            }) -%}
            {%- if reuseRestriction.accessRestriction.dataCannotOpen.dataSharingAgreement.isDefined._value is sameas true -%}
                {%- do reuseRestriction.accessRestriction.dataCannotOpen.dataSharingAgreement.update({
                    "description": reuseRestrictionItem.accessRestriction.canDataOpen.isDataSharingAgreementRequired.isDefined.description|default(None),
                    "documentLink": reuseRestrictionItem.accessRestriction.canDataOpen.isDataSharingAgreementRequired.isDefined.documentLink|default(None),
                    "document": reuseRestrictionItem.accessRestriction.canDataOpen.isDataSharingAgreementRequired.isDefined.document|default(None),
                }) -%}
            {%- endif -%}
        {%- endif -%}
    {%- endif -%}
    {%- if reuseRestriction.accessRestriction.dataRightsArrangement._value == "other" -%}
        {%- do reuseRestriction.accessRestriction.dataRightsArrangement.update({
            "_value": reuseRestrictionItem.accessRestriction.dataRightsArrangement.other._value|default(None),
        }) -%}
    {%- endif -%}
    {%- if reuseRestriction.accessRestriction.isDocumentationAvailable._value is sameas false -%}
        {%- do reuseRestriction.accessRestriction.update({
            "noDocumentationAvailableReason": reuseRestrictionItem.accessRestriction.isDocumentationAvailable.noDocumentationAvailableReason|default(None),
        }) -%}
    {%- endif -%}
    {%- if reuseRestriction.accessRestriction.isMetadataAvailable._value is sameas false -%}
        {%- do reuseRestriction.accessRestriction.update({
            "noMetadataAvailableReason": reuseRestrictionItem.accessRestriction.isMetadataAvailable.noMetadataAvailableReason|default(None),
        }) -%}
    {%- endif -%}

