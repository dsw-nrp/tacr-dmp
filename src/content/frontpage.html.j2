{%- set eu_header = assets("static/eu-header.png") -%}
{%- set eu_flag = assets("static/eu-flag.png") -%}
{%- set tacr_logo = assets("static/tacr-1.svg") -%}
<header>
  <center>
  <img src="{{ tacr_logo.src_value }}" width="90%" class="frontpage-img" />
  </center>
  <h1>{{ data.meta.document.name }}</h1>





  <div class="info">
    <h3>
    Data Management Plan
  </h3>


    <div class="version-info">
      {% for version in dc.project.versions if version.uuid == dc.project.version %}
        <div class="version">{{version.name}}</div>
      {% endfor %}
      <div class="date">{{ data.meta.document.createdAt|datetime_format("%d %B %Y") }}</div>


    </div>



    <p class="note">
        Data Management Plan for Technology agency of the Czech Republic (TA CR) created in  <a href="{{ dc.config.service_url }}" target="_blank"> {{dc.config.service_name}}</a>. Corresponds with Horizon Europe DMP template.
    </p>
  </div>
</header>
